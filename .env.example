# ServiceM8 OAuth application credentials.
# Copy this file to ".env" and fill in your values. ".env" is gitignored.
#
# Register a Public Application in the ServiceM8 Developer Directory to obtain
# an App ID (client_id) and App Secret (client_secret):
#   https://developer.servicem8.com/docs/authentication
#
#   SERVICE_M8_CLIENT_ID=your-app-id
#   SERVICE_M8_CLIENT_SECRET=your-app-secret
#
# The redirect URI the app must be registered with:
#   http://127.0.0.1:9177/oauth/callback
#
